rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ────────────────────────────────────────────────────────────
    // Users can only read/write their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Lectures ─────────────────────────────────────────────────────────
    // Teachers can create and read their own lectures.
    // Students can read all lectures.
    match /lectures/{lectureId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.teacherId;
    }

    // ── Summaries ────────────────────────────────────────────────────────
    // Any authenticated user can read summaries.
    // Only the server (admin SDK) should write — but allow authenticated writes too.
    match /summaries/{summaryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Tasks ────────────────────────────────────────────────────────────
    // Students can read approved tasks.
    // Teachers can read/write tasks they own.
    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.teacherId;
    }

    // ── Notifications ────────────────────────────────────────────────────
    // Users can read notifications addressed to them or to 'all'.
    // Only authenticated users can write (server creates broadcast notifications).
    match /notifications/{notifId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || resource.data.userId == 'all');
      allow write: if request.auth != null;
    }
  }
}
